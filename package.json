{
  "name": "focus-tomato",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Aplicacion Pomodoro profesional y visual para Windows.",
  "main": "src/main/main.js",
  "author": "Focus Tomato",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "serve": "node server.js",
    "desktop": "node scripts/generate-icon.js && electron .",
    "dist": "node scripts/generate-icon.js && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis portable --publish never",
    "release": "node scripts/generate-icon.js && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis portable --publish always"
  },
  "build": {
    "appId": "com.focustomato.app",
    "productName": "Focus Tomato",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "lgbohorquezoUnad",
      "repo": "AppPomodoros"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/tomato-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Focus Tomato",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "ico": "^0.3.3",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
